{
  "name": "@cruce/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "preview": "tsx scripts/dev.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "venues": "tsx scripts/venues.ts",
    "swap-check": "tsx --env-file-if-exists=.env scripts/swap-check.ts",
    "live-check": "tsx --env-file-if-exists=.env scripts/live-check.ts",
    "identity": "tsx --env-file-if-exists=.env scripts/update-identity.ts",
    "pay-check": "tsx --env-file-if-exists=.env scripts/pay-check.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@hono/node-server": "^1.14.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "^4.13.0",
    "postgres": "^3.4.9",
    "viem": "^2.57.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
